# ── Device ───────────────────────────────────────────────────────────────────
# Which device to drive: its CoreDevice identifier, hardware UDID, or name.
# Leave it unset when only one device is connected — that is the normal case,
# and the server refuses to guess between two rather than driving the wrong one.
# `ios_device_list_devices` prints all three forms.
# IOS_DEVICE_ID=DAC88BCC-D5EA-5860-9D51-E40C579DFAB8

# ── WebDriverAgent ───────────────────────────────────────────────────────────
# Everything that sees or touches the screen — screenshot, ui_tree, tap, swipe,
# type — goes through a WebDriverAgent runner on the device. Nothing here needs
# setting for the normal path: the server derives the URL from the tunnel
# CoreDevice already maintains for a connected device, which is what removes the
# usual `iproxy` / usbmux / Appium-server layer entirely.
#
# Set this only when something else is forwarding the port, e.g. an `iproxy 8100
# 8100` you run yourself, or WDA reached over Wi-Fi on the LAN.
# IOS_DEVICE_WDA_URL=http://127.0.0.1:8100
#
# The port WDA listens on. 8100 is WebDriverAgent's own default.
# IOS_DEVICE_WDA_PORT=8100
#
# How long to wait for WDA. `/source` on a busy screen is not fast, so 30s is
# not generous.
# IOS_DEVICE_WDA_TIMEOUT_MS=30000
#
# A paired device whose tunnel has gone idle — the normal state for a phone
# reached over Wi-Fi between runs — is woken automatically before it is judged
# unreachable. This caps that wake-up attempt, which runs against every
# candidate at once, so it should stay short: a device that is genuinely gone
# should fail fast rather than hold up resolution.
# IOS_DEVICE_WARM_TIMEOUT_MS=15000

# ── Safety ───────────────────────────────────────────────────────────────────
# Off by default. With it off, the tools that drive the device — tap,
# tap_element, swipe, type, press_button, install, launch, terminate,
# pull_container — are not registered at all: they do not appear in tools/list
# and cannot be called. What remains is the observe half: list_devices,
# list_apps, get_display_info, screenshot, ui_tree, diagnostics.
#
# Turn it on only when you intend an agent to act on a real phone in someone's
# hand. The startup banner prints `writes=ENABLED` so this is visible.
# IOS_DEVICE_ALLOW_WRITES=1

# Launch arguments applied by `ios_device_launch` when the call does not pass
# its own. This exists for one specific accident: an app whose plain launch
# opens the owner's real account, and whose debug build has a flag that opens
# fixtures instead. Setting it here makes the safe launch the default one rather
# than the one you have to remember.
#   Canopy, for instance: -CanopyDemoMode
# IOS_DEVICE_LAUNCH_ARGS=-CanopyDemoMode

# ── Tuning ───────────────────────────────────────────────────────────────────
# Byte cap on an `ios_device_ui_tree` payload. The raw WebDriverAgent hierarchy
# for one real screen is tens of KB of JSON; this is the last line of defence
# behind the pruning itself, and a truncated answer says so explicitly.
# IOS_DEVICE_MAX_TREE_BYTES=24000

# Budget for one `xcrun devicectl` call. A large `install` genuinely takes
# minutes, which is what this number is sized for.
# IOS_DEVICE_TIMEOUT_MS=120000

# Where screenshots saved with `save_path` and pulled containers land.
# IOS_DEVICE_OUTPUT_DIR=/tmp/mcp-ios-device

# Log every devicectl and WebDriverAgent call to stderr.
# IOS_DEVICE_DEBUG=1

# Alternative toolchain paths, if Xcode is somewhere unusual.
# IOS_DEVICE_XCRUN_PATH=/usr/bin/xcrun
# IOS_DEVICE_SIPS_PATH=/usr/bin/sips

# A JSON file with the same keys in camelCase, read when the environment does
# not set a field. Defaults to ~/.config/ios-device-mcp/config.json.
# IOS_DEVICE_CONFIG=/path/to/config.json
